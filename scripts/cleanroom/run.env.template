# run.env.template: run environment for a clean-room re-run into a scratch DB (N1.3).
#
# Parameterized copy of workspace/cleanroom_2026_10/cleanroom.env, which hard-codes
# cars_cleanroom (:41-42), its folders (:53-57) and roster.txt (:95). Load it ONLY
# inside the env -i launch shell (docs: plan Section 7.0 "Scratch-DB scan runs"):
#
#     set -a
#     . scripts/cleanroom/run.env.template --db cars_cr_x --art workspace/cleanroom_runs/cars_cr_x \
#         --roster workspace/cleanroom_runs/cars_cr_x/roster.txt
#     set +a
#     bash scripts/cleanroom/preflight.sh --db cars_cr_x --art workspace/cleanroom_runs/cars_cr_x \
#         --roster workspace/cleanroom_runs/cars_cr_x/roster.txt --sha <expected HEAD>
#
# Every writer lands under the run root <art> = workspace/cleanroom_runs/<db>:
# <art>/{recipes_cache,dealer_logs,runs,manifest,workspace/scanlogs}. Sourcing refuses
# (returns 2, exports nothing) when --db is cars or cars_cleanroom, when --db is not a
# cars_cr_* / cars_rehearsal scratch name, or when an argument is missing.
# Never source it into an interactive shell that also runs read-only queries on 'cars'.
# This file is bash (compgen, ${!v}); run.env.template never creates files or DBs.

(return 0 2>/dev/null) || { echo "run.env.template: source it (set -a; . $0 --db ...), do not execute it" >&2; exit 2; }
_cr_db= _cr_art= _cr_roster= _cr_bad=
while [ $# -gt 0 ]; do
  case "$1" in
    --db) _cr_db=${2:-}; shift 2 2>/dev/null || shift;;
    --art) _cr_art=${2:-}; shift 2 2>/dev/null || shift;;
    --roster) _cr_roster=${2:-}; shift 2 2>/dev/null || shift;;
    *) echo "run.env.template: unknown argument $1" >&2; _cr_bad=1; shift;;
  esac
done
_cr_repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
case "$_cr_db" in /*|*/*) _cr_bad=1; echo "run.env.template: --db is a database name, not a path" >&2;; esac
case "$_cr_db" in
  cars|cars_cleanroom|'') echo "run.env.template: REFUSED write target '${_cr_db}' (frozen or live DB)" >&2; _cr_bad=1;;
esac
if [ -z "$_cr_bad" ] && ! [[ "$_cr_db" =~ ^(cars_cr_[a-z0-9_]+|cars_rehearsal)$ ]]; then
  echo "run.env.template: REFUSED '$_cr_db' (scratch DBs are cars_cr_<name> or cars_rehearsal)" >&2; _cr_bad=1
fi
if [ -z "$_cr_bad" ] && { [ -z "$_cr_art" ] || [ -z "$_cr_roster" ]; }; then
  echo "run.env.template: --art and --roster are required" >&2; _cr_bad=1
fi
case "$_cr_art" in /*|'') ;; *) _cr_art=$_cr_repo/$_cr_art;; esac
case "$_cr_roster" in /*|'') ;; *) _cr_roster=$_cr_repo/$_cr_roster;; esac
if [ -z "$_cr_bad" ] && [ ! -f "$_cr_roster" ]; then
  echo "run.env.template: roster $_cr_roster not found" >&2; _cr_bad=1
fi
if [ -n "$_cr_bad" ]; then
  unset _cr_db _cr_art _cr_roster _cr_repo _cr_bad
  return 2
fi
unset _cr_bad

# ---------------------------------------------------------------------------
# 1. Remove anything inherited that could redirect the run (cleanroom.env R1-R9, B3, B6, B7)
# ---------------------------------------------------------------------------
unset PGHOST PGHOSTADDR PGPORT PGDATABASE PGUSER PGSERVICE PGSERVICEFILE PGOPTIONS
unset PGVECTOR_URL INVENTORY_AUTO_MIGRATE
unset SCAN_FLEET DEALERS_FROM_DB DEALERS_FROM_ACTIVE_INVENTORY
unset SCANNER_ALLOW_BROWSER SCANNER_EGRESS_TAG SCANNER_GALLERY_VISION_INLINE SCANNER_POST_ENRICH_VISION
unset SCANNER_DELTA_CONCURRENCY SCANNER_DELTA_DEALER_TIMEOUT
unset RECIPES_DB_DISABLED PROJECT_DOTENV_DISABLE
unset SCANNER_HTTP_PROXY HTTPS_PROXY HTTP_PROXY https_proxy http_proxy ALL_PROXY all_proxy NO_PROXY no_proxy
unset FLASK_ENV ENV VAULT_ADDR VAULT_TOKEN
for _cr_v in $(compgen -e | grep -E '^RAILWAY_'); do unset "$_cr_v"; done
unset _cr_v

# ---------------------------------------------------------------------------
# 2. Database: the scratch DB on Homebrew PG (/tmp:5432) only
# ---------------------------------------------------------------------------
export CR_DB=$_cr_db
export CR_ART=$_cr_art
export CR_ROSTER=$_cr_roster
export INVENTORY_DATABASE_URL="postgresql:///${_cr_db}?host=/tmp&port=5432"
export DATABASE_URL="postgresql:///${_cr_db}?host=/tmp&port=5432"
# pg_stat_activity on cars / cars_cleanroom with this name must stay 0.
export PGAPPNAME="cleanroom_run_${_cr_db}"
# The scratch DB's schema is copied from cars and then migrate --apply'd (plan 7.0).
export INVENTORY_SCHEMA_CHECK=strict

# ---------------------------------------------------------------------------
# 3. File isolation: every writer under the run root
# ---------------------------------------------------------------------------
export RECIPES_CACHE_DIR="$_cr_art/recipes_cache"
export DEALER_LOGS_ROOT="$_cr_art/dealer_logs"
export SCAN_OUT_ROOT="$_cr_art/runs"
# fleet_scan sets one lock per shard under its run dir; a direct dealer_pipeline run uses this one.
export SCANNER_LOCK_PATH="$_cr_art/runs/scanner.lock"
# fleet_scan.prune deletes <repo>/workspace/scanlogs/scan_*.jsonl older than this. Never 0.
export SCAN_KEEP_DAYS=36500
# Scanner roster file; orchestrator.py puts the scanner JSONL log at <manifest>/../../workspace/scanlogs,
# i.e. <art>/workspace/scanlogs. Built from the roster by scripts/cleanroom/make_manifest.sh.
export DEALERS_MANIFEST_PATH="$_cr_art/manifest/scanner_dealers.json"
export DEALERS_FROM_SCANNABLE=0
# fleet_scan splits on whitespace: no spaces in paths.
export SCAN_PIPELINE_ARGS="--no-discover --manifest $_cr_art/manifest/pipeline_dealers.json"
export SCANNER_NETWORK_LEDGER=0
export SCANNER_FAILURE_HAR=0
export PYTHONDONTWRITEBYTECODE=1

# ---------------------------------------------------------------------------
# 4. Paid steps OFF; auto-heal OFF (owner decision 2026-10-09)
# ---------------------------------------------------------------------------
export SCANNER_AUTO_HEAL=0
export ANTHROPIC_API_KEY=
export OPENAI_API_KEY=
export GOOGLE_MAPS_API_KEY=
export GOOGLE_CSE_API_KEY=
export EIA_API_KEY=
export RESEND_API_KEY=
export KMAC_VAULT_DISABLE=1
export LISTING_DESC_PARSE_USE_LLM=0
export SCANNER_MONRONEY_VISION=0

# ---------------------------------------------------------------------------
# 5. Roster and fleet shape
# ---------------------------------------------------------------------------
export SCAN_DEALERS="$(grep -v '^[[:space:]]*\(#\|$\)' "$_cr_roster" | tr -d ' \t\r' | paste -sd, -)"
export SCAN_SHARDS=${SCAN_SHARDS:-8}
export SCAN_BATCH=${SCAN_BATCH:-6}
export SCAN_POST_STEPS=${SCAN_POST_STEPS:-1}
unset _cr_db _cr_art _cr_roster _cr_repo
