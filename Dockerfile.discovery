# Discovery worker — the ONE image that carries a headless browser.
#
# Runs dealer_jobs "onboard" jobs: discovery_probe --browser-capture (HTTP probe,
# template synthesis, then a Playwright capture of the SRP's inventory endpoints
# when no template describes the site). Writes recipes + discovery logs, never
# car rows. Scans never run here (docs/HTTP_ONLY_SCANS_PLAN.md).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git gcc g++ libffi-dev \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    libpango-1.0-0 libpangocairo-1.0-0 libgtk-3-0 libx11-xcb1 libxcb-dri3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SCANNER_ALLOW_BROWSER=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN playwright install chromium && playwright install-deps chromium

COPY . .

RUN chmod +x /app/scripts/docker-entrypoint-scanner-worker.sh

ENV SCANNER_WORKER_JOB_TYPES=onboard
ENTRYPOINT ["/app/scripts/docker-entrypoint-scanner-worker.sh"]
