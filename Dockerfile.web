FROM python:3.12-slim

# System deps for Playwright (Chromium) and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget ca-certificates gnupg git \
    # Chromium system deps (Playwright installs its own binary but needs these libs)
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    libpango-1.0-0 libpangocairo-1.0-0 libgtk-3-0 libx11-xcb1 libxcb-dri3-0 \
    # Build deps for some Python packages
    gcc g++ libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir gunicorn[gthread] -r requirements.txt

# Browser binary: Playwright Chromium only.
#
# Car-chat web research launches it in-process (backend/utils/web_researcher.py:363,
# gated by CAR_CHAT_WEB_RESEARCH), so the web image genuinely needs this one.
#
# Patchright's Chromium is NOT installed here: its only consumer was
# backend/oem/scraper/crawl4ai_discovery.py, whose sole caller (scanner.js) was
# deleted with the Node scanner; the module itself was deleted 2026-10-01
# (docs/monolith_audit_2026_10_01/enrich.md #12). Dropping the second full
# browser download here saves ~400MB of image and its build time.
RUN playwright install chromium && playwright install-deps chromium

# Copy application code
COPY . .

# Precompressed .gz/.br siblings for /static (served by backend/main.py::_static_view).
RUN python scripts/build_static_compressed.py --quiet

EXPOSE 8000

RUN chmod +x /app/scripts/docker-entrypoint-web.sh

# Shell entrypoint expands $PORT (Railway) and preloads kmac vault when reachable.
ENTRYPOINT ["/app/scripts/docker-entrypoint-web.sh"]
