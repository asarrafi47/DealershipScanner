FROM python:3.12-slim

# System deps for Playwright (Chromium) and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget ca-certificates gnupg git \
    # Chromium system deps (Playwright installs its own binary but needs these libs)
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    libpango-1.0-0 libpangocairo-1.0-0 libgtk-3-0 libx11-xcb1 libxcb-dri3-0 \
    # Build deps for some Python packages
    gcc g++ libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir gunicorn[gthread] -r requirements.txt

# Browser binaries: Playwright (Python) + Patchright (Crawl4AI 0.8)
RUN playwright install chromium && playwright install-deps chromium && \
    patchright install chromium && patchright install-deps chromium

# Copy application code
COPY . .

EXPOSE 8000

# 1 worker (SQLite is single-writer) + 4 threads (SocketIO threading mode)
CMD ["gunicorn", "-w", "1", "--threads", "4", "-b", "0.0.0.0:8000", \
     "--timeout", "120", "--graceful-timeout", "30", \
     "backend.main:app"]
