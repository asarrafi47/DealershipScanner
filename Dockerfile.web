FROM python:3.12-slim

# System packages: fetch/TLS tools and build deps. No browser and none of
# Chromium's system libraries (P3.8, D-SEC1 (a)).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget ca-certificates gnupg git \
    # Build deps for some Python packages
    gcc g++ libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir gunicorn[gthread] -r requirements.txt

# No browser binary (P3.8, D-SEC1 (a), 2026-10-18).
#
# The web image used to run `playwright install chromium && playwright
# install-deps chromium` because car-chat web research launched headless
# Chromium in-process, as root and with --no-sandbox, for any signed-in user.
# Car chat is now HTTP-only: WebResearcher defaults to allow_browser=False and
# never imports Playwright (backend/utils/web_researcher.py). Browser mode is
# opt-in for the operator script backend/scripts/analyze_trim_adds_with_web.py,
# which runs on a dev host, not here. Scanner browser paths need
# SCANNER_ALLOW_BROWSER (backend/scanner/browser_gate.py), which web does not
# set; with no browser in the image they could not launch here anyway.
#
# The playwright pip package still installs from requirements.txt until P15B.2
# splits the web requirements; without the browser download it is inert.
# Do not add a Playwright or Patchright browser install here; a static test
# (backend/tests/test_web_researcher.py) fails if this file gains one.

# Copy application code
COPY . .

# Precompressed .gz/.br siblings for /static (served by backend/web/static.py::_static_view).
RUN python scripts/build_static_compressed.py --quiet

EXPOSE 8000

RUN chmod +x /app/scripts/docker-entrypoint-web.sh

# Shell entrypoint expands $PORT (Railway) and preloads kmac vault when reachable.
ENTRYPOINT ["/app/scripts/docker-entrypoint-web.sh"]
