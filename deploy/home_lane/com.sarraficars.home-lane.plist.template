<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: the home-IP lane (P15A.2). A template: install_launchd.sh renders
  __REPO_ROOT__ (the prod-lane clone), __HOME__, __HOUR__ and __MINUTE__ and loads it only
  with --load. Default time 02:00 America/New_York, which ends before Railway's 09:00 UTC run.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sarraficars.home-lane</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/deploy/home_lane/run_home_lane.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/home-lane.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/home-lane.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
