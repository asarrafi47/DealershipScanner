{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.web"
  },
  "deploy": {
    "startCommand": "python -m backend.scripts.build_listings_grid_cards",
    "cronSchedule": "30 8 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
