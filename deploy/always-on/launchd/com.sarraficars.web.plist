<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sarraficars.web</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/env</string>
		<string>bash</string>
		<string>-lc</string>
		<string>cd /Users/YOU/DealershipScanner &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; exec python3 -m gunicorn -w 1 --threads 4 -b 0.0.0.0:5001 --timeout 120 --graceful-timeout 30 backend.main:app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/sarraficars-web.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/sarraficars-web.err.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/YOU/DealershipScanner</string>
</dict>
</plist>
