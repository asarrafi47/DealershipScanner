[Unit]
Description=Sarrafi Cars Flask web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sarraficars
Group=sarraficars
WorkingDirectory=/opt/DealershipScanner
EnvironmentFile=/opt/DealershipScanner/.env
Environment=PUBLIC=1
Environment=PORT=5001
# Production-style WSGI (matches Dockerfile.web); use run.py only for interactive local dev.
ExecStart=/usr/bin/python3 -m gunicorn -w 1 --threads 4 -b 0.0.0.0:5001 --timeout 120 --graceful-timeout 30 backend.main:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
