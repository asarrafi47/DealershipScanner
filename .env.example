# ============================================================
# .env.example — copy to .env and fill in your values
#   cp .env.example .env
# .env is gitignored; this file is tracked as a template.
# ============================================================


# ------------------------------------------------------------
# Core app
# ------------------------------------------------------------

# "development" | "production"
FLASK_ENV=development

# Required in production — use a long random string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=local-dev-secret-change-me-not-for-production
FLASK_SECRET_KEY=local-dev-secret-change-me-not-for-production

# Port the Flask/Gunicorn server listens on (default: 5001)
# PORT=5001


# ------------------------------------------------------------
# Admin / first-run access
# ------------------------------------------------------------

# Console login password at /admin  (default: "changeme")
# ADMIN_PASSWORD=changeme

# Seed an app-level admin user on first boot
# ALLOW_DEFAULT_APP_USER=1
# APP_ADMIN_EMAILS=you@example.com
# APP_ADMIN_USERNAMES=yourname


# ------------------------------------------------------------
# Database — SQLite (default, zero config)
# ------------------------------------------------------------

# Allow SQLite without encryption key during local dev
ALLOW_UNENCRYPTED_USER_DB=1

# Override default paths (leave blank to use repo root defaults)
# INVENTORY_DB_PATH=/absolute/path/to/inventory.db
# USERS_DB_PATH=/absolute/path/to/users.db
# DEV_USERS_DB_PATH=/absolute/path/to/dev_users.db
# DEALER_PORTAL_DB_PATH=/absolute/path/to/dealer_portal.db
# INCOMPLETE_LISTINGS_DB_PATH=/absolute/path/to/incomplete_listings.db

# SQLCipher encryption keys — required when ALLOW_UNENCRYPTED_USER_DB is unset
# USERS_DB_ENCRYPTION_KEY=
# DEV_USERS_DB_ENCRYPTION_KEY=


# ------------------------------------------------------------
# Database — Postgres (optional; app falls back to SQLite)
# ------------------------------------------------------------

# Inventory (replaces inventory.db when set)
# INVENTORY_DATABASE_URL=postgresql://user:pass@localhost:5432/dealership

# Semantic / pgvector search (replaces local Chroma when set)
# PGVECTOR_URL=postgresql://user:pass@localhost:5432/dealership_vectors
# DATABASE_URL=postgresql://user:pass@localhost:5432/dealership_vectors


# ------------------------------------------------------------
# AI / Claude — optional (features degrade gracefully without)
# ------------------------------------------------------------

# Anthropic Claude (vision, chat, trim analysis)
# ANTHROPIC_API_KEY=sk-ant-...

# Vision concurrency / rate-limit tuning (defaults built in)
# ANTHROPIC_VISION_RPM=60
# ANTHROPIC_VISION_MAX_RETRIES=3


# ------------------------------------------------------------
# Scanner tuning — optional (sane defaults built in)
# ------------------------------------------------------------

# Set to 0 to run browsers headed (useful for debugging scrapes)
# HEADLESS=1

# Directory where VDP gallery images are saved
# SCANNER_VDP_IMAGE_DOWNLOAD_DIR=./data/runtime/vdp_images

# Download VDP images (set to 1 to enable; off by default)
# SCANNER_VDP_DOWNLOAD_IMAGES=0

# Parallel enrichment workers
# ENRICHMENT_MAX_WORKERS=4


# ------------------------------------------------------------
# Email / SMTP — optional (password reset, notifications)
# ------------------------------------------------------------

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com


# ------------------------------------------------------------
# Billing — Stripe (optional)
# ------------------------------------------------------------

# BILLING_STRIPE_ENABLED=0
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...


# ------------------------------------------------------------
# Google OAuth (optional)
# ------------------------------------------------------------

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/auth/google/callback
# GOOGLE_OAUTH_SHOW_BUTTON=0
# GOOGLE_OAUTH_OFFER_PREMIUM_ON_LOGIN=0


# ------------------------------------------------------------
# Google APIs (optional — dealer ratings, maps, web research)
# ------------------------------------------------------------

# GOOGLE_MAPS_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=


# ------------------------------------------------------------
# Production / Cloudflare tunnel
# ------------------------------------------------------------

# PUBLIC_SITE_URL=https://yourdomain.com
# CLOUDFLARED_TUNNEL_NAME=your-tunnel-name

# Trust X-Forwarded-For from reverse proxy
# TRUST_PROXY_HEADERS=1

# Enforce HTTPS-only session cookies (set in production)
# SESSION_COOKIE_SECURE=1

# Content-Security-Policy mode
# CSP_ENFORCE=0
# CSP_REPORT_ONLY=1


# ------------------------------------------------------------
# Dev / debug — never set in production
# ------------------------------------------------------------

# DEV_CONSOLE=0
# DEV_CONSOLE_SECRET=
# DEV_IP_ALLOWLIST=127.0.0.1
# DB_ADMIN_DEBUG=0
# DB_ADMIN_TOKEN=
